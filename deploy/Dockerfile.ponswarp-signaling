FROM ubuntu:24.04
ARG RELEASE_ID=unknown
LABEL org.opencontainers.image.title="ponswarp-signaling" \
      org.opencontainers.image.revision="$RELEASE_ID"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates tini curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 -g nogroup ponswarp

COPY ponswarp-signaling-rs /usr/local/bin/ponswarp-signaling-rs

USER ponswarp
EXPOSE 5502
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD curl -f http://127.0.0.1:5502/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/ponswarp-signaling-rs"]
